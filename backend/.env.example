# Server Environment
PORT=10000
NODE_ENV=production
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Database Configuration (Supabase PostgreSQL)
# Copy your Transaction Pooler or Direct Connection string from Supabase:
# Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.your-ref:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_TYPE=postgres
DB_SSL=true

# PNS Push Gateway Mode
# Set to true for mock sandbox testing (no real APNs/FCM keys needed)
# Set to false once live APNs/FCM credentials are configured per game
PUSH_MOCK_MODE=true
