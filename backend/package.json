{
  "name": "gametune-kit-backend",
  "version": "1.0.0",
  "description": "GameTuneKit Production NestJS Microservice Backend for Push Notification Service (PNS)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && ls -la dist/main.js",
    "start": "node --experimental-require-module dist/main",
